# URL base de la API (usa el proxy de Vite definido en vite.config.js)
VITE_API_URL=/api

# URL pública del sitio (usada para generar etiquetas SEO/Open Graph y enlaces canónicos).
# Debe coincidir con el dominio real publicado en robots.txt y sitemap.xml.
VITE_SITE_URL=https://tudominio.com

# Clave pública de Stripe (obtener en https://dashboard.stripe.com)
VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY_HERE
