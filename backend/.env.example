# MongoDB Configuración
MONGODB_URL=mongodb://localhost:27017/landing-project

# URL del frontend (usada para construir enlaces de verificación / restablecimiento)
FRONTEND_URL=http://localhost:5173

# Stripe Configuración (obtener en https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY_HERE

# Email Configuración (usar Gmail o servicio de correo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_contraseña_app
EMAIL_FROM=tu_email@gmail.com

# JWT (genera una clave aleatoria larga, p.ej. con `openssl rand -hex 32`)
JWT_SECRET=cambia-esta-clave-en-produccion

# Puerto
PORT=8000

# Usuario administrador sembrado al arrancar (cámbialo antes de desplegar)
ADMIN_EMAIL=admin@aerolab.com
ADMIN_PASSWORD=admin123
