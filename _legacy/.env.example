# === CONFIGURACIÓN DE MONGODB ===

# OPCIÓN 1: MongoDB Local (si lo tienes instalado)
# MONGODB_URL=mongodb://localhost:27017/landing-project

# OPCIÓN 2: MongoDB Atlas (Gratis en la nube - RECOMENDADO)
# 1. Crea una cuenta en https://www.mongodb.com/cloud/atlas
# 2. Crea un cluster gratuito
# 3. Copia la conexión y reemplaza <usuario> y <contraseña>
# MONGODB_URL=mongodb+srv://usuario:contraseña@cluster.mongodb.net/landing-project?retryWrites=true&w=majority

# === CONFIGURACIÓN DE STRIPE ===
# 1. Crea una cuenta en https://stripe.com
# 2. Ve a Dashboard → API Keys
# 3. Copia las claves de prueba
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY_HERE

# === CONFIGURACIÓN DE EMAIL (Gmail) ===
# 1. Activa 2FA en tu cuenta de Google
# 2. Ve a https://myaccount.google.com/apppasswords
# 3. Crea una "App password" para aplicaciones
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=app_password_generado
EMAIL_FROM=tu_email@gmail.com

# === PUERTO ===
PORT=8080
